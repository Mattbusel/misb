import builtins
from typing import Any, Dict, List, Literal, Optional, Tuple, final

__version__: str
UAS_LOCAL_SET_KEY: bytes

__all__ = [
    "Builder",
    "UAS_LOCAL_SET_KEY",
    "checksum",
    "decode_item",
    "parse",
    "split",
    "tag_info",
    "__version__",
]

_Status = Literal["ok", "out_of_range", "invalid", "raw"]
_Item = Dict[str, Any]

def parse(data: bytes, verify: bool = True) -> Tuple[List[_Item], int]: ...
def decode_item(tag: int, raw: bytes) -> _Item: ...
def tag_info(tag: int) -> Optional[Dict[str, Any]]: ...
def checksum(data: bytes) -> int: ...
def split(stream: bytes) -> List[Tuple[bytes, bytes, bytes]]: ...

# Builder has methods named int and float, so the class body names the
# builtins through these aliases.
_int = builtins.int
_float = builtins.float

@final
class Builder:
    def __new__(cls, timestamp_us: _int) -> "Builder": ...
    def float(self, tag: _int, value: _float, length: Optional[_int] = None) -> "Builder": ...
    def uint(self, tag: _int, value: _int) -> "Builder": ...
    def int(self, tag: _int, value: _int) -> "Builder": ...
    def text(self, tag: _int, value: str) -> "Builder": ...
    def time(self, tag: _int, us: _int) -> "Builder": ...
    def raw(self, tag: _int, value: bytes) -> "Builder": ...
    def finish(self) -> bytes: ...
